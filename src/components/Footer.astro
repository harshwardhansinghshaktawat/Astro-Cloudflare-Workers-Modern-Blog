							</svg>
						</a>
						<a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="View our GitHub">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
						</a>
						<a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Connect on LinkedIn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</a>
						<a href="/rss.xml" aria-label="RSS Feed">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
								<path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248C1.456 24 0 22.546 0 20.752s1.456-3.248 3.252-3.248c1.795 0 3.251 1.454 3.251 3.248zM1.677 6.082v4.148c6.685 0 12.093 5.407 12.093 12.092h4.148c0-8.981-7.26-16.24-16.241-16.24zM1.677 0v4.148c9.893 0 17.915 8.022 17.915 17.915H24C24 9.837 14.163 0 1.677 0z"/>
							</svg>
						</a>
					</div>
				</div>

				<!-- Quick Links -->
				<div class="footer-links">
					<h4 class="footer-section-title">Quick Links</h4>
					<ul class="footer-nav">
						<li><a href="/">Home</a></li>
						<li><a href="/blog">Blog</a></li>
						<li><a href="/about">About</a></li>
						<li><a href="/contact">Contact</a></li>
					</ul>
				</div>

				<!-- Categories -->
				<div class="footer-links">
					<h4 class="footer-section-title">Categories</h4>
					<ul class="footer-nav">
						<li><a href="/blog/category/technology">Technology</a></li>
						<li><a href="/blog/category/lifestyle">Lifestyle</a></li>
						<li><a href="/blog/category/tutorials">Tutorials</a></li>
						<li><a href="/blog/category/reviews">Reviews</a></li>
					</ul>
				</div>

				<!-- Legal -->
				<div class="footer-links">
					<h4 class="footer-section-title">Legal</h4>
					<ul class="footer-nav">
						<li><a href="/privacy">Privacy Policy</a></li>
						<li><a href="/terms">Terms of Service</a></li>
						<li><a href="/sitemap.xml">Sitemap</a></li>
					</ul>
				</div>
			</div>

			<!-- Newsletter Signup -->
			<div class="newsletter-section">
				<h4 class="newsletter-title">Stay Updated</h4>
				<p class="newsletter-description">Get the latest posts delivered right to your inbox.</p>
				<form class="newsletter-form" action="/api/newsletter" method="POST">
					<div class="newsletter-input-group">
						<input 
							type="email" 
							name="email" 
							placeholder="Enter your email" 
							required 
							aria-label="Email address for newsletter"
							class="newsletter-input"
						/>
						<button type="submit" class="btn btn-primary newsletter-button">
							Subscribe
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Footer Bottom -->
		<div class="footer-bottom">
			<div class="footer-bottom-content">
				<p class="copyright">
					© {currentYear} {siteName}. All rights reserved.
				</p>
				<p class="footer-meta">
					Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 
					and ❤️
				</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: linear-gradient(135deg, var(--gray-900) 0%, var(--gray-800) 100%);
		color: var(--gray-100);
		margin-top: var(--space-24);
	}

	.footer-content {
		padding: var(--space-16) 0 var(--space-8);
	}

	.footer-main {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: var(--space-12);
		margin-bottom: var(--space-16);
	}

	.footer-brand {
		max-width: 350px;
	}

	.footer-title {
		font-size: var(--text-xl);
		font-weight: 700;
		color: white;
		margin-bottom: var(--space-4);
	}

	.footer-description {
		color: var(--gray-300);
		margin-bottom: var(--space-6);
		line-height: 1.6;
	}

	.social-links {
		display: flex;
		gap: var(--space-4);
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		background-color: var(--gray-700);
		color: var(--gray-300);
		border-radius: var(--radius-full);
		transition: var(--transition);
		text-decoration: none;
	}

	.social-links a:hover {
		background-color: var(--primary);
		color: white;
		transform: translateY(-2px);
		text-decoration: none;
	}

	.footer-section-title {
		font-size: var(--text-base);
		font-weight: 600;
		color: white;
		margin-bottom: var(--space-4);
	}

	.footer-nav {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-nav li {
		margin-bottom: var(--space-2);
	}

	.footer-nav a {
		color: var(--gray-300);
		text-decoration: none;
		font-size: var(--text-sm);
		transition: var(--transition);
	}

	.footer-nav a:hover {
		color: var(--primary-light);
		text-decoration: none;
	}

	.newsletter-section {
		background-color: var(--gray-800);
		border-radius: var(--radius-xl);
		padding: var(--space-8);
		border: 1px solid var(--gray-700);
	}

	.newsletter-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: white;
		margin-bottom: var(--space-2);
	}

	.newsletter-description {
		color: var(--gray-300);
		margin-bottom: var(--space-6);
		font-size: var(--text-sm);
	}

	.newsletter-input-group {
		display: flex;
		gap: var(--space-3);
	}

	.newsletter-input {
		flex: 1;
		background-color: var(--gray-700);
		border: 1px solid var(--gray-600);
		color: white;
		border-radius: var(--radius-md);
		padding: var(--space-3);
		font-size: var(--text-sm);
	}

	.newsletter-input::placeholder {
		color: var(--gray-400);
	}

	.newsletter-input:focus {
		border-color: var(--primary);
		background-color: var(--gray-600);
	}

	.newsletter-button {
		white-space: nowrap;
		font-size: var(--text-sm);
		padding: var(--space-3) var(--space-5);
	}

	.footer-bottom {
		border-top: 1px solid var(--gray-700);
		padding: var(--space-6) 0;
	}

	.footer-bottom-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.copyright,
	.footer-meta {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin: 0;
	}

	.footer-meta a {
		color: var(--primary-light);
		text-decoration: none;
	}

	.footer-meta a:hover {
		text-decoration: underline;
	}

	/* Responsive Design */
	@media (max-width: 1024px) {
		.footer-main {
			grid-template-columns: 1fr 1fr 1fr;
			gap: var(--space-8);
		}

		.footer-brand {
			grid-column: 1 / -1;
			max-width: 100%;
			margin-bottom: var(--space-8);
		}
	}

	@media (max-width: 768px) {
		.footer-content {
			padding: var(--space-12) 0 var(--space-6);
		}

		.footer-main {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-6);
		}

		.newsletter-section {
			margin-top: var(--space-8);
		}

		.newsletter-input-group {
			flex-direction: column;
		}

		.newsletter-button {
			width: 100%;
		}

		.footer-bottom-content {
			flex-direction: column;
			text-align: center;
			gap: var(--space-2);
		}
	}

	@media (max-width: 480px) {
		.footer-main {
			grid-template-columns: 1fr;
		}
		
		.social-links {
			justify-content: center;
		}
	}

	/* Dark theme adjustments */
	@media (prefers-color-scheme: dark) {
		.site-footer {
			background: linear-gradient(135deg, #000000 0%, var(--gray-900) 100%);
		}
	}
</style>
