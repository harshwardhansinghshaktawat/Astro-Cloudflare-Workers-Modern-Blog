---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Terms of Service" 
			description="Read our terms of service to understand the rules and guidelines for using our blog and website."
			keywords="terms of service, terms and conditions, legal, website usage, user agreement"
		/>
	</head>

	<body>
		<Header />

		<main class="terms-main">
			<div class="container">
				<div class="terms-content">
					<header class="terms-header">
						<h1 class="terms-title">Terms of Service</h1>
						<p class="terms-subtitle">
							Last updated: <time datetime="2024-01-01">January 1, 2024</time>
						</p>
						<p class="terms-intro">
							By accessing and using this website, you accept and agree to be bound by the terms and provision of this agreement.
						</p>
					</header>

					<div class="terms-toc">
						<h2>Table of Contents</h2>
						<ol>
							<li><a href="#acceptance">Acceptance of Terms</a></li>
							<li><a href="#description">Description of Service</a></li>
							<li><a href="#user-accounts">User Accounts</a></li>
							<li><a href="#acceptable-use">Acceptable Use Policy</a></li>
							<li><a href="#content">Content and Intellectual Property</a></li>
							<li><a href="#user-content">User-Generated Content</a></li>
							<li><a href="#privacy">Privacy</a></li>
							<li><a href="#disclaimers">Disclaimers</a></li>
							<li><a href="#limitation">Limitation of Liability</a></li>
							<li><a href="#indemnification">Indemnification</a></li>
							<li><a href="#termination">Termination</a></li>
							<li><a href="#modifications">Modifications</a></li>
							<li><a href="#governing-law">Governing Law</a></li>
							<li><a href="#contact-terms">Contact Information</a></li>
						</ol>
					</div>

					<div class="terms-sections">
						<section id="acceptance" class="terms-section">
							<h2>1. Acceptance of Terms</h2>
							<p>By accessing and using this website ("Service") operated by Your Blog Name ("us", "we", or "our"), you acknowledge that you have read, understood, and agree to be bound by these Terms of Service ("Terms").</p>
							
							<p>If you do not agree to these Terms, please do not use our Service. These Terms apply to all visitors, users, and others who access or use the Service.</p>
						</section>

						<section id="description" class="terms-section">
							<h2>2. Description of Service</h2>
							<p>Our website is a blog platform that provides articles, insights, and content related to technology, lifestyle, tutorials, and other topics. The Service includes:</p>
							<ul>
								<li>Blog articles and posts</li>
								<li>Newsletter subscriptions</li>
								<li>Comment sections (if applicable)</li>
								<li>Contact forms</li>
								<li>Social media integration</li>
							</ul>
						</section>

						<section id="user-accounts" class="terms-section">
							<h2>3. User Accounts</h2>
							<h3>Account Creation</h3>
							<p>Some features of our Service may require you to create an account. When creating an account, you must provide accurate and complete information.</p>

							<h3>Account Security</h3>
							<p>You are responsible for:</p>
							<ul>
								<li>Maintaining the confidentiality of your account credentials</li>
								<li>All activities that occur under your account</li>
								<li>Notifying us immediately of any unauthorized use</li>
							</ul>

							<h3>Account Termination</h3>
							<p>We reserve the right to terminate or suspend accounts that violate these Terms or for any other reason at our sole discretion.</p>
						</section>

						<section id="acceptable-use" class="terms-section">
							<h2>4. Acceptable Use Policy</h2>
							<p>You agree not to use the Service for any unlawful purpose or in any way that could damage, disable, or impair the Service. Prohibited activities include:</p>

							<h3>Prohibited Content</h3>
							<ul>
								<li>Illegal, harmful, or offensive content</li>
								<li>Spam, unsolicited messages, or advertisements</li>
								<li>Content that infringes on intellectual property rights</li>
								<li>False, misleading, or deceptive information</li>
								<li>Harassment, threats, or personal attacks</li>
								<li>Malware, viruses, or malicious code</li>
							</ul>

							<h3>Prohibited Activities</h3>
							<ul>
								<li>Attempting to gain unauthorized access to our systems</li>
								<li>Interfering with the proper functioning of the Service</li>
								<li>Collecting user information without consent</li>
								<li>Impersonating others or providing false identity information</li>
								<li>Using automated tools to access the Service</li>
							</ul>
						</section>

						<section id="content" class="terms-section">
							<h2>5. Content and Intellectual Property</h2>
							<h3>Our Content</h3>
							<p>All content on this website, including text, graphics, logos, images, and software, is the property of Your Blog Name or its content suppliers and is protected by copyright and other intellectual property laws.</p>

							<h3>License to Use</h3>
							<p>We grant you a limited, non-exclusive, non-transferable license to access and use our content for personal, non-commercial purposes, subject to these Terms.</p>

							<h3>Restrictions</h3>
							<p>You may not:</p>
							<ul>
								<li>Reproduce, distribute, or create derivative works from our content</li>
								<li>Use our content for commercial purposes without permission</li>
								<li>Remove copyright notices or other proprietary markings</li>
								<li>Reverse engineer or attempt to extract source code</li>
							</ul>
						</section>

						<section id="user-content" class="terms-section">
							<h2>6. User-Generated Content</h2>
							<h3>Content You Submit</h3>
							<p>When you submit content to our Service (such as comments, feedback, or suggestions), you grant us a worldwide, royalty-free, perpetual license to use, reproduce, modify, and distribute such content.</p>

							<h3>Content Standards</h3>
							<p>All user-generated content must:</p>
							<ul>
								<li>Be accurate and not misleading</li>
								<li>Respect the rights of others</li>
								<li>Comply with applicable laws and regulations</li>
								<li>Not violate our Acceptable Use Policy</li>
							</ul>

							<h3>Moderation</h3>
							<p>We reserve the right to review, modify, or remove user-generated content at our discretion without notice.</p>
						</section>

						<section id="privacy" class="terms-section">
							<h2>7. Privacy</h2>
							<p>Your privacy is important to us. Our Privacy Policy explains how we collect, use, and protect your information. By using our Service, you agree to the collection and use of information in accordance with our Privacy Policy.</p>
							
							<p>Please review our <a href="/privacy">Privacy Policy</a> for detailed information about our privacy practices.</p>
						</section>

						<section id="disclaimers" class="terms-section">
							<h2>8. Disclaimers</h2>
							<h3>No Warranty</h3>
							<p>The Service is provided on an "as is" and "as available" basis. We make no warranties, expressed or implied, regarding:</p>
							<ul>
								<li>The accuracy or completeness of content</li>
								<li>The availability or reliability of the Service</li>
								<li>The suitability of the Service for your needs</li>
								<li>The absence of errors or interruptions</li>
							</ul>

							<h3>Professional Advice</h3>
							<p>Content on our website is for informational purposes only and should not be considered professional advice. Always consult with qualified professionals for specific guidance.</p>

							<h3>Third-Party Links</h3>
							<p>Our Service may contain links to third-party websites. We are not responsible for the content, privacy policies, or practices of external sites.</p>
						</section>

						<section id="limitation" class="terms-section">
							<h2>9. Limitation of Liability</h2>
							<p>To the maximum extent permitted by law, Your Blog Name shall not be liable for any indirect, incidental, special, consequential, or punitive damages, including but not limited to:</p>
							<ul>
								<li>Loss of profits or revenue</li>
								<li>Loss of data or information</li>
								<li>Business interruption</li>
								<li>Personal injury or property damage</li>
							</ul>

							<p>Our total liability for any claims arising from these Terms or your use of the Service shall not exceed the amount you paid us in the 12 months preceding the claim.</p>
						</section>

						<section id="indemnification" class="terms-section">
							<h2>10. Indemnification</h2>
							<p>You agree to indemnify, defend, and hold harmless Your Blog Name and its affiliates from any claims, damages, losses, or expenses arising from:</p>
							<ul>
								<li>Your use of the Service</li>
								<li>Your violation of these Terms</li>
								<li>Your violation of any rights of others</li>
								<li>Any content you submit or share</li>
							</ul>
						</section>

						<section id="termination" class="terms-section">
							<h2>11. Termination</h2>
							<h3>Termination by You</h3>
							<p>You may stop using our Service at any time. If you have an account, you may delete it according to our account deletion procedures.</p>

							<h3>Termination by Us</h3>
							<p>We may terminate or suspend your access to the Service immediately, without prior notice, for any reason, including if you breach these Terms.</p>

							<h3>Effect of Termination</h3>
							<p>Upon termination, your right to use the Service will cease immediately. Provisions that should survive termination will remain in effect.</p>
						</section>

						<section id="modifications" class="terms-section">
							<h2>12. Modifications</h2>
							<h3>Changes to Terms</h3>
							<p>We reserve the right to modify these Terms at any time. We will notify users of significant changes by:</p>
							<ul>
								<li>Posting the updated Terms on our website</li>
								<li>Updating the "Last updated" date</li>
								<li>Sending email notifications (if applicable)</li>
							</ul>

							<h3>Acceptance of Changes</h3>
							<p>Your continued use of the Service after changes are posted constitutes acceptance of the new Terms.</p>

							<h3>Changes to Service</h3>
							<p>We may modify, suspend, or discontinue any part of the Service at any time without notice.</p>
						</section>

						<section id="governing-law" class="terms-section">
							<h2>13. Governing Law</h2>
							<p>These Terms are governed by and construed in accordance with the laws of the State of California, United States, without regard to conflict of law principles.</p>

							<h3>Dispute Resolution</h3>
							<p>Any disputes arising from these Terms or your use of the Service will be resolved through:</p>
							<ol>
								<li>Good faith negotiations</li>
								<li>Binding arbitration if negotiations fail</li>
								<li>Courts of California as a last resort</li>
							</ol>

							<h3>Severability</h3>
							<p>If any provision of these Terms is found unenforceable, the remaining provisions will remain in full force and effect.</p>
						</section>

						<section id="contact-terms" class="terms-section">
							<h2>14. Contact Information</h2>
							<p>If you have any questions about these Terms of Service, please contact us:</p>
							
							<div class="contact-info">
								<p><strong>Email:</strong> <a href="mailto:legal@yourblog.com">legal@yourblog.com</a></p>
								<p><strong>Address:</strong><br>
								Your Blog Name<br>
								123 Legal Street<br>
								San Francisco, CA 94102<br>
								United States</p>
								<p><strong>Response Time:</strong> We typically respond within 3-5 business days</p>
							</div>
						</section>
					</div>

					<div class="terms-footer">
						<div class="terms-summary">
							<h3>Quick Summary</h3>
							<p>While we encourage you to read the full Terms of Service, here's a quick summary:</p>
							<ul>
								<li>Be respectful and lawful in your use of our website</li>
								<li>Don't copy or misuse our content without permission</li>
								<li>We're not liable for damages beyond what's legally required</li>
								<li>We may update these terms from time to time</li>
								<li>Contact us if you have questions or concerns</li>
							</ul>
						</div>
						
						<p class="legal-note">
							<strong>Legal Disclaimer:</strong> This terms of service template is for general guidance only. Please consult with a legal professional to ensure compliance with applicable laws in your jurisdiction.
						</p>
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.terms-main {
		padding: var(--space-16) 0;
		min-height: calc(100vh - var(--header-height));
	}

	.terms-content {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 var(--space-4);
	}

	/* Header */
	.terms-header {
		text-align: center;
		margin-bottom: var(--space-12);
		padding-bottom: var(--space-8);
		border-bottom: 2px solid var(--border);
	}

	.terms-title {
		font-size: var(--text-5xl);
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: var(--space-4);
		background: linear-gradient(135deg, var(--primary), var(--accent));
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.terms-subtitle {
		font-size: var(--text-lg);
		color: var(--text-muted);
		margin-bottom: var(--space-6);
		font-weight: 500;
	}

	.terms-intro {
		font-size: var(--text-lg);
		color: var(--text-secondary);
		line-height: 1.7;
		max-width: 600px;
		margin: 0 auto;
	}

	/* Table of Contents */
	.terms-toc {
		background: var(--bg-secondary);
		padding: var(--space-8);
		border-radius: var(--radius-xl);
		margin-bottom: var(--space-12);
		border: 1px solid var(--border);
	}

	.terms-toc h2 {
		font-size: var(--text-2xl);
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: var(--space-6);
	}

	.terms-toc ol {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--space-3);
		padding-left: 0;
		list-style: none;
		counter-reset: toc-counter;
	}

	.terms-toc li {
		counter-increment: toc-counter;
		margin-bottom: var(--space-2);
	}

	.terms-toc li::before {
		content: counter(toc-counter) ". ";
		font-weight: 600;
		color: var(--primary);
	}

	.terms-toc a {
		color: var(--text-secondary);
		text-decoration: none;
		transition: var(--transition);
		font-weight: 500;
	}

	.terms-toc a:hover {
		color: var(--primary);
		text-decoration: underline;
	}

	/* Sections */
	.terms-sections {
		display: flex;
		flex-direction: column;
		gap: var(--space-12);
	}

	.terms-section {
		scroll-margin-top: var(--space-20);
	}

	.terms-section h2 {
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-3);
		border-bottom: 2px solid var(--primary);
		position: relative;
	}

	.terms-section h2::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 60px;
		height: 2px;
		background: linear-gradient(90deg, var(--primary), var(--accent));
	}

	.terms-section h3 {
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--text-primary);
		margin-top: var(--space-8);
		margin-bottom: var(--space-4);
	}

	.terms-section p {
		font-size: var(--text-base);
		line-height: 1.7;
		color: var(--text-secondary);
		margin-bottom: var(--space-4);
	}

	.terms-section ul,
	.terms-section ol {
		margin-bottom: var(--space-4);
		padding-left: var(--space-6);
	}

	.terms-section li {
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: var(--space-2);
	}

	.terms-section li strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.terms-section a {
		color: var(--primary);
		text-decoration: underline;
		font-weight: 500;
	}

	.terms-section a:hover {
		color: var(--primary-dark);
	}

	/* Contact Info */
	.contact-info {
		background: var(--bg-secondary);
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		margin-top: var(--space-6);
		border-left: 4px solid var(--primary);
	}

	.contact-info p {
		margin-bottom: var(--space-3);
		color: var(--text-primary);
	}

	.contact-info p:last-child {
		margin-bottom: 0;
	}

	/* Footer */
	.terms-footer {
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--border);
	}

	.terms-summary {
		background: linear-gradient(135deg, var(--primary), var(--accent));
		color: white;
		padding: var(--space-8);
		border-radius: var(--radius-xl);
		margin-bottom: var(--space-8);
	}

	.terms-summary h3 {
		font-size: var(--text-2xl);
		font-weight: 700;
		margin-bottom: var(--space-4);
		color: white;
	}

	.terms-summary p {
		margin-bottom: var(--space-4);
		opacity: 0.9;
		color: white;
	}

	.terms-summary ul {
		padding-left: var(--space-6);
		margin: 0;
	}

	.terms-summary li {
		color: white;
		opacity: 0.9;
		margin-bottom: var(--space-2);
	}

	.legal-note {
		background: var(--bg-secondary);
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		border-left: 4px solid var(--accent);
		font-size: var(--text-sm);
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.legal-note strong {
		color: var(--text-primary);
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.terms-title {
			font-size: var(--text-4xl);
		}

		.terms-toc {
			padding: var(--space-6);
		}

		.terms-toc ol {
			grid-template-columns: 1fr;
		}

		.terms-section h2 {
			font-size: var(--text-2xl);
		}

		.terms-section h3 {
			font-size: var(--text-lg);
		}

		.contact-info {
			padding: var(--space-4);
		}

		.terms-summary {
			padding: var(--space-6);
		}
	}

	@media (max-width: 480px) {
		.terms-main {
			padding: var(--space-12) 0;
		}

		.terms-title {
			font-size: var(--text-3xl);
		}

		.terms-intro {
			font-size: var(--text-base);
		}
	}

	/* Smooth scrolling for anchor links */
	html {
		scroll-behavior: smooth;
	}

	/* Focus styles for accessibility */
	.terms-toc a:focus,
	.terms-section a:focus {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}
</style>
