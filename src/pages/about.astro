---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="About" 
			description="Learn more about our blog, our mission, and the story behind the content we create."
			keywords="about, blog, mission, story, author, background"
		/>
	</head>

	<body>
		<Header />

		<main class="about-main">
			<!-- Hero Section -->
			<section class="about-hero">
				<div class="container">
					<div class="hero-content">
						<div class="hero-text">
							<h1 class="hero-title">About Our Story</h1>
							<p class="hero-description">
								Welcome to our corner of the internet where curiosity meets creativity, and ideas come to life through thoughtful writing and meaningful conversations.
							</p>
						</div>
						<div class="hero-image">
							<img 
								src="/images/about-hero.jpg" 
								alt="About us"
								width="500"
								height="400"
								loading="eager"
							/>
						</div>
					</div>
				</div>
			</section>

			<!-- Main Content -->
			<section class="about-content">
				<div class="container">
					<div class="content-grid">
						<!-- Story Section -->
						<div class="story-section">
							<h2 class="section-title">Our Journey</h2>
							<div class="story-content">
								<p>
									What started as a simple desire to share knowledge has evolved into a platform where technology meets humanity. Founded in 2020, our blog began as a weekend project and has grown into a trusted resource for thousands of readers worldwide.
								</p>
								<p>
									We believe that the best content comes from authentic experiences, deep research, and a genuine desire to help others learn and grow. Every article we publish is crafted with care, backed by real-world experience, and designed to provide actionable value to our readers.
								</p>
								<p>
									Our journey has been shaped by the incredible feedback and support from our community. From humble beginnings with a handful of readers to reaching thousands each month, we're grateful for every person who has joined us along the way.
								</p>
							</div>
						</div>

						<!-- Mission Section -->
						<div class="mission-section">
							<h2 class="section-title">Our Mission</h2>
							<div class="mission-cards">
								<div class="mission-card">
									<div class="mission-icon">
										<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
											<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
										</svg>
									</div>
									<h3 class="mission-title">Quality First</h3>
									<p class="mission-description">
										We prioritize quality over quantity, ensuring every piece of content provides genuine value and insight to our readers.
									</p>
								</div>
								
								<div class="mission-card">
									<div class="mission-icon">
										<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
											<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
										</svg>
									</div>
									<h3 class="mission-title">Accessibility</h3>
									<p class="mission-description">
										We make complex topics accessible to everyone, breaking down barriers between experts and beginners.
									</p>
								</div>
								
								<div class="mission-card">
									<div class="mission-icon">
										<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
											<path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zM4 18v-4h2v2h2v2H4zm0-4V6l2.5-1.25L8 5.5 10 4l2 1-1.5 1.5L12 7.5l1.5-1L16 8l2-1 1.5 2.5L22 8v8c0 1.11-.89 2-2 2H4c-1.11 0-2-.89-2-2V14h2z"/>
										</svg>
									</div>
									<h3 class="mission-title">Community</h3>
									<p class="mission-description">
										We foster a community of learners, creators, and innovators who support and inspire each other.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Author Section -->
			<section class="author-section">
				<div class="container">
					<h2 class="section-title">Meet the Author</h2>
					<div class="author-card">
						<div class="author-image">
							<img 
								src="/images/author-photo.jpg" 
								alt="Author photo"
								width="200"
								height="200"
							/>
						</div>
						<div class="author-info">
							<h3 class="author-name">Your Name</h3>
							<p class="author-role">Founder & Lead Writer</p>
							<div class="author-bio">
								<p>
									With over 8 years of experience in technology and digital marketing, I'm passionate about making complex concepts accessible to everyone. When I'm not writing, you can find me exploring new technologies, reading science fiction, or hiking in the mountains.
								</p>
								<p>
									I believe that the best learning happens when we share our experiences and learn from each other. That's why I started this blog – to create a space where knowledge flows freely and everyone can contribute to the conversation.
								</p>
							</div>
							<div class="author-stats">
								<div class="stat">
									<span class="stat-number">200+</span>
									<span class="stat-label">Articles Written</span>
								</div>
								<div class="stat">
									<span class="stat-number">50K+</span>
									<span class="stat-label">Monthly Readers</span>
								</div>
								<div class="stat">
									<span class="stat-number">5+</span>
									<span class="stat-label">Years Blogging</span>
								</div>
							</div>
							<div class="author-social">
								<a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
										<path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
									</svg>
								</a>
								<a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
									</svg>
								</a>
								<a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
									<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
										<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Values Section -->
			<section class="values-section">
				<div class="container">
					<h2 class="section-title">What We Stand For</h2>
					<div class="values-grid">
						<div class="value-item">
							<h3 class="value-title">Authenticity</h3>
							<p class="value-description">
								We share real experiences, both successes and failures, to provide genuine insights that you can trust and learn from.
							</p>
						</div>
						<div class="value-item">
							<h3 class="value-title">Continuous Learning</h3>
							<p class="value-description">
								We're always learning, always growing, and always excited to share new discoveries with our community.
							</p>
						</div>
						<div class="value-item">
							<h3 class="value-title">Inclusivity</h3>
							<p class="value-description">
								Our content is designed to be accessible to everyone, regardless of their background or experience level.
							</p>
						</div>
						<div class="value-item">
							<h3 class="value-title">Innovation</h3>
							<p class="value-description">
								We embrace new ideas, technologies, and approaches to create content that pushes boundaries and inspires action.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section">
				<div class="container">
					<div class="cta-content">
						<h2 class="cta-title">Join Our Community</h2>
						<p class="cta-description">
							Ready to be part of our journey? Subscribe to our newsletter for the latest insights, behind-the-scenes content, and exclusive resources.
						</p>
						<div class="cta-actions">
							<a href="/contact" class="btn btn-primary btn-large">
								Get in Touch
							</a>
							<a href="/blog" class="btn btn-secondary btn-large">
								Read Our Blog
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-main {
		min-height: calc(100vh - var(--header-height));
	}

	/* Hero Section */
	.about-hero {
		padding: var(--space-16) 0;
		background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
	}

	.hero-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-12);
		align-items: center;
	}

	.hero-title {
		font-size: var(--text-5xl);
		font-weight: 700;
		margin-bottom: var(--space-6);
		background: linear-gradient(135deg, var(--primary), var(--accent));
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		font-size: var(--text-xl);
		line-height: 1.6;
		color: var(--text-secondary);
	}

	.hero-image {
		display: flex;
		justify-content: center;
	}

	.hero-image img {
		border-radius: var(--radius-2xl);
		box-shadow: var(--shadow-xl);
		max-width: 100%;
		height: auto;
	}

	/* Content Sections */
	.about-content {
		padding: var(--space-20) 0;
	}

	.content-grid {
		display: grid;
		gap: var(--space-16);
	}

	.section-title {
		font-size: var(--text-4xl);
		font-weight: 700;
		text-align: center;
		margin-bottom: var(--space-12);
		color: var(--text-primary);
	}

	/* Story Section */
	.story-content {
		max-width: 800px;
		margin: 0 auto;
	}

	.story-content p {
		font-size: var(--text-lg);
		line-height: 1.7;
		color: var(--text-secondary);
		margin-bottom: var(--space-6);
	}

	/* Mission Section */
	.mission-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: var(--space-8);
		margin-top: var(--space-8);
	}

	.mission-card {
		background: var(--bg-primary);
		padding: var(--space-8);
		border-radius: var(--radius-xl);
		text-align: center;
		border: 1px solid var(--border);
		transition: var(--transition);
	}

	.mission-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary);
	}

	.mission-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		background: linear-gradient(135deg, var(--primary), var(--accent));
		color: white;
		border-radius: var(--radius-xl);
		margin-bottom: var(--space-6);
	}

	.mission-title {
		font-size: var(--text-xl);
		font-weight: 600;
		margin-bottom: var(--space-4);
		color: var(--text-primary);
	}

	.mission-description {
		color: var(--text-secondary);
		line-height: 1.6;
	}

	/* Author Section */
	.author-section {
		padding: var(--space-20) 0;
		background-color: var(--bg-secondary);
	}

	.author-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-12);
		max-width: 1000px;
		margin: 0 auto;
		background: var(--bg-primary);
		padding: var(--space-12);
		border-radius: var(--radius-2xl);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-lg);
	}

	.author-image {
		display: flex;
		justify-content: center;
	}

	.author-image img {
		border-radius: var(--radius-full);
		border: 4px solid var(--primary);
		width: 200px;
		height: 200px;
		object-fit: cover;
	}

	.author-name {
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: var(--space-2);
	}

	.author-role {
		font-size: var(--text-lg);
		color: var(--primary);
		font-weight: 600;
		margin-bottom: var(--space-6);
	}

	.author-bio p {
		font-size: var(--text-base);
		line-height: 1.7;
		color: var(--text-secondary);
		margin-bottom: var(--space-4);
	}

	.author-stats {
		display: flex;
		gap: var(--space-8);
		margin: var(--space-8) 0;
		padding: var(--space-6) 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.stat {
		text-align: center;
	}

	.stat-number {
		display: block;
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--primary);
	}

	.stat-label {
		font-size: var(--text-sm);
		color: var(--text-muted);
		font-weight: 500;
	}

	.author-social {
		display: flex;
		gap: var(--space-4);
	}

	.author-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		background-color: var(--bg-secondary);
		color: var(--text-muted);
		border-radius: var(--radius-full);
		transition: var(--transition);
		text-decoration: none;
	}

	.author-social a:hover {
		background-color: var(--primary);
		color: white;
		transform: translateY(-2px);
	}

	/* Values Section */
	.values-section {
		padding: var(--space-20) 0;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: var(--space-8);
	}

	.value-item {
		text-align: center;
		padding: var(--space-6);
	}

	.value-title {
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--primary);
		margin-bottom: var(--space-4);
	}

	.value-description {
		color: var(--text-secondary);
		line-height: 1.6;
	}

	/* CTA Section */
	.cta-section {
		padding: var(--space-20) 0;
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
		color: white;
	}

	.cta-content {
		text-align: center;
		max-width: 600px;
		margin: 0 auto;
	}

	.cta-title {
		font-size: var(--text-4xl);
		font-weight: 700;
		margin-bottom: var(--space-6);
	}

	.cta-description {
		font-size: var(--text-lg);
		line-height: 1.6;
		margin-bottom: var(--space-8);
		opacity: 0.9;
	}

	.cta-actions {
		display: flex;
		gap: var(--space-4);
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-large {
		padding: var(--space-4) var(--space-8);
		font-size: var(--text-lg);
	}

	/* Responsive Design */
	@media (max-width: 1024px) {
		.hero-content {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.hero-image {
			order: -1;
		}

		.author-card {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.author-stats {
			justify-content: center;
		}
	}

	@media (max-width: 768px) {
		.hero-title {
			font-size: var(--text-4xl);
		}

		.section-title {
			font-size: var(--text-3xl);
		}

		.author-card {
			padding: var(--space-8);
		}

		.author-stats {
			flex-direction: column;
			gap: var(--space-4);
		}

		.cta-actions {
			flex-direction: column;
			align-items: center;
		}

		.btn-large {
			width: 100%;
			max-width: 300px;
		}
	}

	@media (max-width: 480px) {
		.about-hero {
			padding: var(--space-12) 0;
		}

		.hero-title {
			font-size: var(--text-3xl);
		}

		.hero-description {
			font-size: var(--text-lg);
		}

		.mission-cards {
			grid-template-columns: 1fr;
		}

		.values-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
