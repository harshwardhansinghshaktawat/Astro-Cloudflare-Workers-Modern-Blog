---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

// Get all blog posts
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Get unique tags for filtering
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();

// Get featured post (most recent)
const featuredPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Blog" 
			description="Explore our latest articles, tutorials, and insights on technology, lifestyle, and more."
			keywords="blog, articles, tutorials, technology, lifestyle, insights"
		/>
	</head>

	<body>
		<Header />

		<main class="blog-main">
			<!-- Blog Header -->
			<section class="blog-header">
				<div class="container">
					<div class="header-content">
						<h1 class="page-title">Latest Articles</h1>
						<p class="page-description">
							Discover insights, tutorials, and stories from our journey in technology and beyond.
						</p>
						<div class="blog-stats">
							<div class="stat">
								<span class="stat-number">{allPosts.length}</span>
								<span class="stat-label">Articles Published</span>
							</div>
							<div class="stat">
								<span class="stat-number">{allTags.length}</span>
								<span class="stat-label">Topics Covered</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Search and Filters -->
			<section class="search-filters">
				<div class="container">
					<div class="search-bar">
						<form class="search-form" role="search">
							<div class="search-input-group">
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" class="search-icon">
									<path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
								</svg>
								<input 
									type="search" 
									name="search" 
									placeholder="Search articles..." 
									class="search-input"
									id="search-input"
								/>
								<button type="submit" class="search-button" aria-label="Search">
									Search
								</button>
							</div>
						</form>
					</div>

					<!-- Filter Tags -->
					<div class="filter-section">
						<div class="filter-header">
							<span class="filter-label">Filter by topic:</span>
							<button class="clear-filters" id="clear-filters" style="display: none;">
								Clear filters
							</button>
						</div>
						<div class="filter-tags">
							<button class="tag-filter active" data-tag="all">All</button>
							{allTags.map((tag) => (
								<button class="tag-filter" data-tag={tag}>
									#{tag}
								</button>
							))}
						</div>
					</div>

					<!-- Sort Options -->
					<div class="sort-section">
						<label for="sort-select" class="sort-label">Sort by:</label>
						<select id="sort-select" class="sort-select">
							<option value="newest">Newest First</option>
							<option value="oldest">Oldest First</option>
							<option value="title">Title A-Z</option>
							<option value="title-desc">Title Z-A</option>
						</select>
					</div>
				</div>
			</section>

			<!-- Featured Post -->
			{featuredPost && (
				<section class="featured-section">
					<div class="container">
						<h2 class="section-title">Featured Article</h2>
						<article class="featured-post">
							<div class="featured-image">
								<img 
									src={featuredPost.data.heroImage || '/images/post-placeholder.jpg'} 
									alt={featuredPost.data.title}
									width="800"
									height="500"
									loading="eager"
								/>
								<div class="featured-badge">Featured</div>
							</div>
							<div class="featured-content">
								<div class="featured-meta">
									<time datetime={featuredPost.data.pubDate.toISOString()}>
										<FormattedDate date={featuredPost.data.pubDate} />
									</time>
									{featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
										<div class="featured-tags">
											{featuredPost.data.tags.slice(0, 3).map((tag: string) => (
												<span class="tag">#{tag}</span>
											))}
										</div>
									)}
								</div>
								<h3 class="featured-title">
									<a href={`/blog/${featuredPost.id}/`}>
										{featuredPost.data.title}
									</a>
								</h3>
								<p class="featured-excerpt">
									{featuredPost.data.description}
								</p>
								<a href={`/blog/${featuredPost.id}/`} class="featured-link">
									Read Full Article
									<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
										<path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
									</svg>
								</a>
							</div>
						</article>
					</div>
				</section>
			)}

			<!-- Posts Grid -->
			<section class="posts-section">
				<div class="container">
					<div class="posts-header">
						<h2 class="section-title">All Articles</h2>
						<div class="posts-count">
							<span id="visible-count">{otherPosts.length}</span> 
							<span class="count-total">of {allPosts.length} articles</span>
						</div>
					</div>
					
					<div class="posts-grid" id="posts-grid">
						{otherPosts.map((post) => (
							<article class="post-card" 
								data-tags={post.data.tags?.join(',') || ''}
								data-title={post.data.title.toLowerCase()}
								data-date={post.data.pubDate.getTime()}
							>
								<a href={`/blog/${post.id}/`} class="post-link">
									<div class="post-image">
										<img 
											src={post.data.heroImage || '/images/post-placeholder.jpg'} 
											alt={post.data.title}
											width="400"
											height="250"
											loading="lazy"
										/>
									</div>
									<div class="post-content">
										<div class="post-meta">
											<time datetime={post.data.pubDate.toISOString()}>
												<FormattedDate date={post.data.pubDate} />
											</time>
											{post.data.tags && post.data.tags.length > 0 && (
												<span class="post-tag">#{post.data.tags[0]}</span>
											)}
										</div>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-excerpt">{post.data.description}</p>
										<div class="post-footer">
											<span class="read-time">5 min read</span>
											<span class="read-more">
												Read more
												<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
													<path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z"/>
												</svg>
											</span>
										</div>
									</div>
								</a>
							</article>
						))}
					</div>

					<!-- Load More Button -->
					<div class="load-more-section" id="load-more-section" style="display: none;">
						<button class="btn btn-secondary btn-large" id="load-more-btn">
							Load More Articles
						</button>
					</div>

					<!-- No Results -->
					<div class="no-results" id="no-results" style="display: none;">
						<div class="no-results-icon">
							<svg viewBox="0 0 24 24" width="64" height="64" fill="currentColor">
								<path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
							</svg>
						</div>
						<h3 class="no-results-title">No articles found</h3>
						<p class="no-results-text">
							Try adjusting your search terms or filters to find what you're looking for.
						</p>
						<button class="btn btn-primary" id="reset-filters">Reset All Filters</button>
					</div>
				</div>
			</section>

			<!-- Newsletter CTA -->
			<section class="newsletter-cta">
				<div class="container">
					<div class="newsletter-card">
						<h2 class="newsletter-title">Never miss an article</h2>
						<p class="newsletter-description">
							Subscribe to our newsletter and get the latest insights delivered to your inbox.
						</p>
						<form class="newsletter-form" action="/api/newsletter" method="POST">
							<div class="newsletter-input-group">
								<input 
									type="email" 
									name="email" 
									placeholder="Enter your email" 
									required 
									class="newsletter-input"
								/>
								<button type="submit" class="newsletter-button">
									Subscribe
								</button>
							</div>
						</form>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const searchInput = document.getElementById('search-input');
				const tagFilters = document.querySelectorAll('.tag-filter');
				const sortSelect = document.getElementById('sort-select');
				const clearFilters = document.getElementById('clear-filters');
				const resetFilters = document.getElementById('reset-filters');
				const postsGrid = document.getElementById('posts-grid');
				const noResults = document.getElementById('no-results');
				const visibleCount = document.getElementById('visible-count');
				
				let currentFilter = 'all';
				let currentSearch = '';
				let currentSort = 'newest';
				const postsPerPage = 12;
				let visiblePosts = postsPerPage;

				function filterAndSortPosts() {
					const posts = Array.from(postsGrid.children);
					let filteredPosts = posts;

					// Apply tag filter
					if (currentFilter !== 'all') {
						filteredPosts = posts.filter(post => {
							const tags = post.dataset.tags?.split(',') || [];
							return tags.includes(currentFilter);
						});
					}

					// Apply search filter
					if (currentSearch) {
						filteredPosts = filteredPosts.filter(post => {
							const title = post.dataset.title || '';
							return title.includes(currentSearch.toLowerCase());
						});
					}

					// Sort posts
					switch (currentSort) {
						case 'oldest':
							filteredPosts.sort((a, b) => 
								parseInt(a.dataset.date) - parseInt(b.dataset.date)
							);
							break;
						case 'title':
							filteredPosts.sort((a, b) => 
								a.dataset.title.localeCompare(b.dataset.title)
							);
							break;
						case 'title-desc':
							filteredPosts.sort((a, b) => 
								b.dataset.title.localeCompare(a.dataset.title)
							);
							break;
						default: // newest
							filteredPosts.sort((a, b) => 
								parseInt(b.dataset.date) - parseInt(a.dataset.date)
							);
					}

					// Hide all posts first
					posts.forEach(post => {
						post.style.display = 'none';
					});

					// Show filtered posts
					filteredPosts.slice(0, visiblePosts).forEach(post => {
						post.style.display = 'block';
					});

					// Update results count
					visibleCount.textContent = Math.min(filteredPosts.length, visiblePosts);

					// Show/hide no results
					if (filteredPosts.length === 0) {
						noResults.style.display = 'block';
						postsGrid.style.display = 'none';
					} else {
						noResults.style.display = 'none';
						postsGrid.style.display = 'grid';
					}

					// Show/hide clear filters button
					if (currentFilter !== 'all' || currentSearch) {
						clearFilters.style.display = 'inline-block';
					} else {
						clearFilters.style.display = 'none';
					}
				}

				// Search functionality
				let searchTimeout;
				searchInput.addEventListener('input', (e) => {
					clearTimeout(searchTimeout);
					searchTimeout = setTimeout(() => {
						currentSearch = e.target.value.trim();
						visiblePosts = postsPerPage;
						filterAndSortPosts();
					}, 300);
				});

				// Tag filter functionality
				tagFilters.forEach(filter => {
					filter.addEventListener('click', (e) => {
						// Update active state
						tagFilters.forEach(f => f.classList.remove('active'));
						e.target.classList.add('active');
						
						currentFilter = e.target.dataset.tag;
						visiblePosts = postsPerPage;
						filterAndSortPosts();
					});
				});

				// Sort functionality
				sortSelect.addEventListener('change', (e) => {
					currentSort = e.target.value;
					filterAndSortPosts();
				});

				// Clear filters
				function clearAllFilters() {
					currentFilter = 'all';
					currentSearch = '';
					currentSort = 'newest';
					visiblePosts = postsPerPage;
					
					searchInput.value = '';
					sortSelect.value = 'newest';
					tagFilters.forEach(f => f.classList.remove('active'));
					tagFilters[0].classList.add('active');
					
					filterAndSortPosts();
				}

				clearFilters.addEventListener('click', clearAllFilters);
				resetFilters.addEventListener('click', clearAllFilters);

				// Initial filter
				filterAndSortPosts();
			});
		</script>
	</body>
</html>

<style>
	.blog-main {
		min-height: calc(100vh - var(--header-height));
	}

	/* Blog Header */
	.blog-header {
		background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
		padding: var(--space-16) 0;
		text-align: center;
	}

	.header-content {
		max-width: 600px;
		margin: 0 auto;
	}

	.page-title {
		font-size: var(--text-5xl);
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: var(--space-4);
		background: linear-gradient(135deg, var(--primary), var(--accent));
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.page-description {
		font-size: var(--text-xl);
		color: var(--text-secondary);
		margin-bottom: var(--space-8);
		line-height: 1.6;
	}

	.blog-stats {
		display: flex;
		justify-content: center;
		gap: var(--space-12);
	}

	.stat {
		text-align: center;
	}

	.stat-number {
		display: block;
		font-size: var(--text-3xl);
		font-weight: 700;
		color: var(--primary);
	}

	.stat-label {
		font-size: var(--text-sm);
		color: var(--text-muted);
		font-weight: 500;
	}

	/* Search and Filters */
	.search-filters {
		padding: var(--space-12) 0;
		background-color: var(--bg-primary);
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: var(--header-height);
		z-index: 20;
	}

	.search-bar {
		margin-bottom: var(--space-8);
	}

	.search-form {
		max-width: 500px;
		margin: 0 auto;
	}

	.search-input-group {
		display: flex;
		align-items: center;
		background: var(--bg-secondary);
		border: 2px solid var(--border);
		border-radius: var(--radius-lg);
		padding: var(--space-2);
		transition: var(--transition);
	}

	.search-input-group:focus-within {
		border-color: var(--primary);
	}

	.search-icon {
		margin: 0 var(--space-3);
		color: var(--text-muted);
	}

	.search-input {
		flex: 1;
		border: none;
		background: transparent;
		padding: var(--space-3) 0;
		font-size: var(--text-base);
		color: var(--text-primary);
		outline: none;
	}

	.search-input::placeholder {
		color: var(--text-muted);
	}

	.search-button {
		background: var(--primary);
		color: white;
		border: none;
		padding: var(--space-3) var(--space-5);
		border-radius: var(--radius-md);
		font-weight: 500;
		cursor: pointer;
		transition: var(--transition);
	}

	.search-button:hover {
		background: var(--primary-dark);
	}

	.filter-section {
		margin-bottom: var(--space-6);
	}

	.filter-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-4);
	}

	.filter-label {
		font-weight: 500;
		color: var(--text-secondary);
	}

	.clear-filters {
		background: none;
		border: none;
		color: var(--primary);
		font-size: var(--text-sm);
		cursor: pointer;
		text-decoration: underline;
	}

	.filter-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.tag-filter {
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--border);
		background: var(--bg-primary);
		color: var(--text-secondary);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
		cursor: pointer;
		transition: var(--transition);
		font-weight: 500;
	}

	.tag-filter:hover,
	.tag-filter.active {
		background: var(--primary);
		color: white;
		border-color: var(--primary);
	}

	.sort-section {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		justify-content: center;
	}

	.sort-label {
		font-weight: 500;
		color: var(--text-secondary);
	}

	.sort-select {
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--bg-primary);
		color: var(--text-primary);
		font-size: var(--text-sm);
	}

	/* Featured Section */
	.featured-section {
		padding: var(--space-16) 0;
		background-color: var(--bg-secondary);
	}

	.section-title {
		font-size: var(--text-3xl);
		font-weight: 700;
		text-align: center;
		margin-bottom: var(--space-12);
		color: var(--text-primary);
	}

	.featured-post {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-12);
		background: var(--bg-primary);
		border-radius: var(--radius-2xl);
		overflow: hidden;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-lg);
	}

	.featured-image {
		position: relative;
		overflow: hidden;
	}

	.featured-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.featured-badge {
		position: absolute;
		top: var(--space-4);
		left: var(--space-4);
		background: linear-gradient(135deg, var(--primary), var(--accent));
		color: white;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
	}

	.featured-content {
		padding: var(--space-8);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.featured-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--space-4);
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.featured-tags {
		display: flex;
		gap: var(--space-2);
	}

	.tag {
		background: var(--bg-secondary);
		color: var(--primary);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		font-size: var(--text-xs);
		font-weight: 500;
	}

	.featured-title {
		font-size: var(--text-3xl);
		margin-bottom: var(--space-4);
		line-height: 1.2;
	}

	.featured-title a {
		color: var(--text-primary);
		text-decoration: none;
	}

	.featured-title a:hover {
		color: var(--primary);
	}

	.featured-excerpt {
		font-size: var(--text-lg);
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: var(--space-6);
	}

	.featured-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--primary);
		font-weight: 600;
		text-decoration: none;
	}

	.featured-link:hover {
		color: var(--primary-dark);
	}

	/* Posts Section */
	.posts-section {
		padding: var(--space-16) 0;
	}

	.posts-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		margin-bottom: var(--space-12);
	}

	.posts-header .section-title {
		margin: 0;
		text-align: left;
	}

	.posts-count {
		font-size: var(--text-lg);
		color: var(--text-secondary);
	}

	.count-total {
		color: var(--text-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: var(--space-8);
		margin-bottom: var(--space-12);
	}

	.post-card {
		background: var(--bg-primary);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		transition: var(--transition);
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary);
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.post-card:hover .post-image img {
		transform: scale(1.05);
	}

	.post-content {
		padding: var(--space-6);
	}

	.post-meta {
		display: flex;
		justify-content: space-between;
